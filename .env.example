# Пример переменных окружения. Скопируйте в .env и при необходимости измените.

# OpenSearch (URL внутри docker-сети)
ES_HOST=http://opensearch:9200
# ES_USER/ES_PASS нужны OpenSearch при старте; security plugin отключён (DISABLE_SECURITY_PLUGIN)
ES_USER=admin
ES_PASS=changeme
ES_INDEX_PATTERN=sre-logs-*
ES_JAVA_OPTS="-Xms512m -Xmx512m"
OPENSEARCH_CLUSTER_NAME=sre-diploma-cluster

# Те же сервисы с хоста (make seed, curl)
ES_HOST_LOCAL=http://localhost:9200
API_URL=http://localhost:8001

# Fluent Bit → OpenSearch
FLUENTBIT_OS_HOST=opensearch
FLUENTBIT_OS_PORT=9200
FLUENTBIT_OS_INDEX_PREFIX=sre-logs

# Ollama (LLM)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_THREADS=2

# API (порт внутри контейнера и снаружи)
LOG_LEVEL=info
API_PORT=8000
API_HOST_PORT=8001

# Проброшенные порты на хост
ES_HOST_PORT=9200
DASHBOARDS_HOST_PORT=5601
OLLAMA_HOST_PORT=11434
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
CADVISOR_HOST_PORT=8080
DOCKER_NET_EXPORTER_PORT=9101

# Grafana (только для локальной демо-среды)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# Параметры анализа и таймауты LLM
ANALYZE_MAX_UNIQUE_ERRORS=5
SEED_LOG_COUNT=15
LLM_TIMEOUT_SECONDS=300
LLM_PER_CALL_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# Нагрузка для Grafana/Prometheus (make demo)
LOADGEN_DURATION=90
LOADGEN_CONCURRENCY=4

# Образ API (локально или из GHCR)
SRE_API_IMAGE=sre-api:local
