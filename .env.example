# OpenSearch (URLs inside docker network)
ES_HOST=http://opensearch:9200
ES_USER=admin
ES_PASS=Admin_Pass123!
ES_INDEX_PATTERN=sre-logs-*
ES_JAVA_OPTS="-Xms512m -Xmx512m"

# Same services from the host (make seed, curl)
ES_HOST_LOCAL=http://localhost:9200
API_URL=http://localhost:8001

# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_THREADS=2

# API
LOG_LEVEL=info
API_PORT=8000
API_HOST_PORT=8001

# Published ports
ES_HOST_PORT=9200
DASHBOARDS_HOST_PORT=5601
OLLAMA_HOST_PORT=11434
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
CADVISOR_HOST_PORT=8080
DOCKER_NET_EXPORTER_PORT=9101

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Analysis
ANALYZE_MAX_UNIQUE_ERRORS=5
SEED_LOG_COUNT=15
LLM_TIMEOUT_SECONDS=300
LLM_PER_CALL_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# Demo traffic for Grafana/Prometheus
LOADGEN_DURATION=90
LOADGEN_CONCURRENCY=4

# Image
SRE_API_IMAGE=sre-api:local
